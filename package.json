{
  "name": "lexical-cljs-closure-repro",
  "private": true,
  "scripts": {
    "build:vanilla": "esbuild vanilla/main.js --bundle --format=iife --define:process.env.NODE_ENV='\"production\"' --define:global=window --minify-syntax --outfile=vanilla/out/intermediate.js && google-closure-compiler --compilation_level=ADVANCED --language_out=ECMASCRIPT_NEXT --js=vanilla/out/intermediate.js --js_output_file=vanilla/out/bundle.js"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "lexical": "0.49.0",
    "@lexical/react": "0.49.0",
    "@lexical/rich-text": "0.49.0"
  },
  "devDependencies": {
    "esbuild": "latest",
    "google-closure-compiler": "latest",
    "shadow-cljs": "^2.28.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
